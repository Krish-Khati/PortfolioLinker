# PortfolioLinker — local secrets. NEVER commit this file.
# It is already in .gitignore.

# --- LLM providers -------------------------------------------------------
# Providers are tried in this order. Each is skipped automatically if it is
# unconfigured, exhausted or offline, so you only need the keys you want.
#   gemini - Google AI Studio free tier, multimodal, ~500 req/day (flash-lite)
#   groq   - fast, but 200,000 tokens/day org-wide on the free tier
#   ollama - local, no quota at all, needs `ollama serve` running
LLM_PROVIDERS=gemini,groq,ollama

# --- Gemini (Google AI Studio) ---
# Free key: https://aistudio.google.com/apikey
# NOTE: free-tier prompts may be used to improve Google products.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_VISION_MODEL=gemini-3.5-flash-lite

# --- Groq ---
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_VISION_MODEL=qwen/qwen3.8-27b

# --- Ollama (local, unlimited) ---
# Install from https://ollama.com then: ollama pull llama3.1:8b && ollama serve
OLLAMA_MODEL=llama3.1:8b

# --- Pixabay (images) ---
PIXABAY_API_KEY=

# --- Google OAuth / Blogger API v3 ---
# From https://console.cloud.google.com/apis/credentials
BLOGGER_CLIENT_ID=
BLOGGER_CLIENT_SECRET=

# Printed once by get_refresh_token.py. Long-lived. Do not regenerate.
BLOGGER_REFRESH_TOKEN=

# From https://www.googleapis.com/blogger/v3/users/self/blogs
BLOGGER_BLOG_ID=

# --- Portfolio (link targets) ---
PORTFOLIO_URL=
PORTFOLIO_BLOG_PAGE_URL=
GITHUB_PROFILE_URL=

# --- Safety switch ---
# "false" = everything goes to Blogger as a DRAFT, never published.
PUBLISH_LIVE=false